JWT_SECRET=
POSTGRES_PASSWORD=
SEED_DEMO=true
APP_ENV=development
# Rafinha: authorize an eligible ChatGPT account in administrator settings.
RAFINHA_MODE=chatgpt
RAFINHA_PROVIDER=catalog
RAFINHA_OLLAMA_URL=http://127.0.0.1:11434
RAFINHA_OLLAMA_MODEL=
# Network and local inference share the administrator's 10 or 30 second budget.
# Legacy hybrid diagnostics only; inactive in chatgpt mode.
WEB_SEARCH_PROVIDER=institutional
# Optional HTTPS SearXNG JSON API for the legacy diagnostic layer.
WEB_SEARCH_URL=
# Prefer the protected administrator panel. Environment keys are opt-in for development only.
RAFINHA_ALLOW_DEV_API_KEYS=false
TAVILY_API_KEY=
OPENAI_API_KEY=
